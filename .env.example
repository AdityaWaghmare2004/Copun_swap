# Copy this file to .env and replace the placeholder values.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local SQLite development default.
DB_ENGINE=sqlite
# DB_ENGINE=postgresql
# DB_NAME=swapstash
# DB_USER=swapstash
# DB_PASSWORD=swapstash-local-only
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Set to True only when you are ready to use S3 for proof uploads.
USE_S3_STORAGE=False
# AWS_STORAGE_BUCKET_NAME=coupon-swap-proof-bucket
# AWS_S3_REGION_NAME=ap-south-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
